include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/DependencyPins.cmake")

# Import the received closure, never Filament's root CMake flags/targets. A
# different platform/configuration needs its own qualification before import.
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR
   NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Production graphics currently receives Windows x64 MSVC Release only. Apple Metal and Linux qualification remain open; use CRUCIBLE_BUILD_GAME=OFF on those targets.")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "The qualified Filament archives are Release /MD. Configure a single-config Release build; Debug/multi-config graphics requires a separately received matching archive closure.")
endif()
if(NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "19.51.36246.0")
    message(FATAL_ERROR "Production import requires received MSVC 19.51.36246.0 (toolset 14.51.36231); current compiler is ${CMAKE_CXX_COMPILER_VERSION}. Requalify before changing toolchains.")
endif()
if(CMAKE_MSVC_RUNTIME_LIBRARY AND
   NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL" AND
   NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    message(FATAL_ERROR "Production import requires /MD, not a static or debug CRT. Remove the runtime override or select MultiThreadedDLL for this Release consumer.")
endif()
set(production_flags "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_RELEASE}")
if(production_flags MATCHES "(^|[ \t])[-/]MTd?([ \t]|$)" OR
   production_flags MATCHES "(^|[ \t])[-/]MDd([ \t]|$)" OR
   production_flags MATCHES "[-/]D[ \t]*(__EXCEPTIONS|UTILS_EXCEPTIONS)")
    message(FATAL_ERROR "Production compiler flags conflict with received /MD and UTILS_EXCEPTIONS=0: ${production_flags}")
endif()

set(CRUCIBLE_FILAMENT_SOURCE_DIR "" CACHE PATH "Clean exact-release Filament qualification source directory")
set(CRUCIBLE_FILAMENT_BUILD_DIR "" CACHE PATH "Received Filament Windows x64 MSVC Release build directory")
if(NOT IS_DIRECTORY "${CRUCIBLE_FILAMENT_SOURCE_DIR}" OR NOT EXISTS "${CRUCIBLE_FILAMENT_BUILD_DIR}/CMakeCache.txt")
    message(FATAL_ERROR "Pass CRUCIBLE_FILAMENT_SOURCE_DIR and CRUCIBLE_FILAMENT_BUILD_DIR from scripts/production/qualify_filament.ps1. The optional production build does not fetch/build graphics dependencies implicitly.")
endif()
if(NOT CRUCIBLE_FILAMENT_REVISION)
    message(FATAL_ERROR "DependencyPins.cmake must define the full received CRUCIBLE_FILAMENT_REVISION before production import.")
endif()
string(LENGTH "${CRUCIBLE_FILAMENT_REVISION}" production_pin_length)
if(NOT production_pin_length EQUAL 40 OR NOT CRUCIBLE_FILAMENT_REVISION MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "CRUCIBLE_FILAMENT_REVISION must be a full lowercase Git commit hash.")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${CRUCIBLE_FILAMENT_SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE production_git_result OUTPUT_VARIABLE production_source_pin
    ERROR_VARIABLE production_git_error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT production_git_result EQUAL 0 OR NOT production_source_pin STREQUAL CRUCIBLE_FILAMENT_REVISION)
    message(FATAL_ERROR "Filament source does not match received pin ${CRUCIBLE_FILAMENT_REVISION}; found '${production_source_pin}'. ${production_git_error}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${CRUCIBLE_FILAMENT_SOURCE_DIR}" status --porcelain --untracked-files=all
    RESULT_VARIABLE production_git_result OUTPUT_VARIABLE production_source_changes
    ERROR_VARIABLE production_git_error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT production_git_result EQUAL 0 OR NOT production_source_changes STREQUAL "")
    message(FATAL_ERROR "Filament qualification source must be clean, including untracked files. Keep generated artifacts outside source and requalify an attributed adaptation. ${production_git_error}\n${production_source_changes}")
endif()

file(READ "${CRUCIBLE_FILAMENT_BUILD_DIR}/CMakeCache.txt" production_cache)
function(crucibleRequireProductionCache name value)
    string(REGEX MATCH "(^|\n)${name}:[^=\r\n]+=${value}(\r?\n|$)" matched "${production_cache}")
    if(NOT matched)
        message(FATAL_ERROR "Filament build cache requires ${name}=${value}. Resume the exact qualification configure/build; do not import a differently configured archive set.")
    endif()
endfunction()
foreach(setting IN ITEMS
    "CMAKE_BUILD_TYPE=Release" "USE_STATIC_CRT=OFF"
    "FILAMENT_SUPPORTS_VULKAN=ON" "FILAMENT_SUPPORTS_OPENGL=OFF"
    "FILAMENT_SUPPORTS_METAL=OFF" "FILAMENT_SUPPORTS_WEBGPU=OFF"
    "FILAMENT_ENABLE_EXCEPTIONS=ON" "FILAMENT_ENABLE_RTTI=ON"
    "FILAMENT_ENABLE_LTO=OFF" "FILAMENT_SHORTEN_MSVC_COMPILATION=OFF"
    "FILAMENT_WINDOWS_CI_BUILD=ON" "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT=Embedded")
    string(REPLACE "=" ";" parts "${setting}")
    list(GET parts 0 name)
    list(GET parts 1 value)
    crucibleRequireProductionCache("${name}" "${value}")
endforeach()
string(REGEX MATCH "(^|\n)CMAKE_HOME_DIRECTORY:INTERNAL=([^\r\n]+)" home_match "${production_cache}")
file(REAL_PATH "${CMAKE_MATCH_2}" production_build_source)
file(REAL_PATH "${CRUCIBLE_FILAMENT_SOURCE_DIR}" production_requested_source)
if(NOT production_build_source STREQUAL production_requested_source)
    message(FATAL_ERROR "Filament archive cache was configured from '${production_build_source}', not supplied source '${production_requested_source}'. Import the matching source/build pair.")
endif()
string(REGEX MATCH "(^|\n)CMAKE_CXX_COMPILER:[^=\r\n]+=([^\r\n]+)" compiler_match "${production_cache}")
file(TO_CMAKE_PATH "${CMAKE_MATCH_2}" production_compiler)
if(NOT production_compiler MATCHES "/14\\.51\\.36231/bin/Hostx64/x64/cl\\.exe$")
    message(FATAL_ERROR "Filament archives require received toolset 14.51.36231 Hostx64/x64; cache records '${production_compiler}'.")
endif()
file(READ "${CRUCIBLE_FILAMENT_SOURCE_DIR}/third_party/imgui/imgui.h" production_imgui_header)
if(NOT production_imgui_header MATCHES "#define[ \t]+IMGUI_VERSION[ \t]+\"1\\.92\\.5\"")
    message(FATAL_ERROR "Filament 1.77.3 import requires its sole matched ImGui 1.92.5 core. Do not link the earlier 1.92.6 audit source.")
endif()

get_filename_component(production_receipt_dir "${CRUCIBLE_FILAMENT_BUILD_DIR}" DIRECTORY)
if(NOT EXISTS "${production_receipt_dir}/inventory.json" OR
   NOT EXISTS "${production_receipt_dir}/compiler_macros.i")
    message(FATAL_ERROR "Missing qualification inventory/macro receipts beside the Release build. Run qualify_filament.ps1 -Stage inspect after the received tools/link stages.")
endif()
file(READ "${production_receipt_dir}/inventory.json" production_inventory)
function(crucibleProductionReceipt output)
    string(JSON value ERROR_VARIABLE error GET "${production_inventory}" ${ARGN})
    if(error)
        message(FATAL_ERROR "Filament qualification receipt lacks ${ARGN}: ${error}. Regenerate the inventory from the exact clean source/build.")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
crucibleProductionReceipt(receipt_pin source pin)
crucibleProductionReceipt(receipt_dirty source dirty)
crucibleProductionReceipt(receipt_imgui imguiVersion)
if(NOT receipt_pin STREQUAL CRUCIBLE_FILAMENT_REVISION OR receipt_dirty OR NOT receipt_imgui STREQUAL "1.92.5")
    message(FATAL_ERROR "Qualification inventory does not identify the clean requested pin/matched ImGui core.")
endif()
file(READ "${production_receipt_dir}/compiler_macros.i" production_macros)
foreach(macro IN ITEMS _CPPUNWIND __EXCEPTIONS UTILS_EXCEPTIONS)
    if(macro STREQUAL "_CPPUNWIND")
        set(expected_macro 1)
    else()
        set(expected_macro 0)
    endif()
    crucibleProductionReceipt(actual_macro compilerMacros "${macro}")
    if(NOT actual_macro STREQUAL "${expected_macro}" OR NOT production_macros MATCHES "P15 ${macro}=${expected_macro}")
        message(FATAL_ERROR "Received MSVC macro ${macro} must equal ${expected_macro}. Do not claim catchable Panic/GPU-loss recovery from the exception option alone.")
    endif()
endforeach()
foreach(unit IN ITEMS "libs/utils/src/Panic.cpp" "filament/src/details/Engine.cpp"
    "filament/backend/src/vulkan/VulkanDriver.cpp" "third_party/imgui/imgui.cpp")
    crucibleProductionReceipt(command compileCommands "${unit}")
    if(NOT command MATCHES "(^|[ \t])[-/]MD([ \t]|$)" OR command MATCHES "(^|[ \t])[-/]MTd?([ \t]|$)")
        message(FATAL_ERROR "Qualification compile command for ${unit} does not receive /MD without static CRT. Rebuild/reinspect the exact archive closure.")
    endif()
endforeach()

set(production_archives
    filament/filament.lib filament/backend/backend.lib libs/math/math.lib libs/utils/utils.lib
    libs/filaflat/filaflat.lib libs/filabridge/filabridge.lib third_party/zstd/tnt/zstd.lib
    libs/bluevk/bluevk.lib third_party/smol-v/tnt/smol-v.lib third_party/getopt/getopt.lib
    third_party/imgui/tnt/imgui.lib)
set(production_tools tools/matc/matc.exe tools/cmgen/cmgen.exe tools/resgen/resgen.exe)
foreach(group IN ITEMS archives tools)
    set(index 0)
    foreach(relative IN LISTS production_${group})
        set(artifact "${CRUCIBLE_FILAMENT_BUILD_DIR}/${relative}")
        if(NOT EXISTS "${artifact}")
            message(FATAL_ERROR "Missing received Filament ${group} artifact: ${artifact}. Resume the qualification build, not a partial release import.")
        endif()
        crucibleProductionReceipt(recorded_path "${group}" "${index}" path)
        crucibleProductionReceipt(recorded_hash "${group}" "${index}" sha256)
        file(SHA256 "${artifact}" actual_hash)
        if(NOT recorded_path STREQUAL "release/${relative}" OR NOT actual_hash STREQUAL recorded_hash)
            message(FATAL_ERROR "Filament ${group} artifact differs from its qualification receipt: ${artifact}. Rebuild/receive/reinspect before promotion.")
        endif()
        math(EXPR index "${index} + 1")
    endforeach()
endforeach()

if(TARGET Crucible::FilamentRuntime OR TARGET Crucible::ImGui)
    message(FATAL_ERROR "Production import requires sole ownership of the matched Filament/ImGui targets. Remove the competing graphics import; do not link duplicate ImGui cores.")
endif()
add_library(crucible_filament_runtime INTERFACE IMPORTED GLOBAL)
add_library(Crucible::FilamentRuntime ALIAS crucible_filament_runtime)
set(production_headers)
foreach(relative IN ITEMS filament/include filament/backend/include libs/filabridge/include libs/math/include libs/utils/include)
    if(NOT IS_DIRECTORY "${CRUCIBLE_FILAMENT_SOURCE_DIR}/${relative}")
        message(FATAL_ERROR "Missing received Filament public include directory: ${relative}")
    endif()
    list(APPEND production_headers "${CRUCIBLE_FILAMENT_SOURCE_DIR}/${relative}")
endforeach()
target_include_directories(crucible_filament_runtime SYSTEM INTERFACE ${production_headers})
set(production_runtime_archives)
foreach(relative IN LISTS production_archives)
    if(NOT relative STREQUAL "third_party/imgui/tnt/imgui.lib")
        list(APPEND production_runtime_archives "${CRUCIBLE_FILAMENT_BUILD_DIR}/${relative}")
    endif()
endforeach()
target_link_libraries(crucible_filament_runtime INTERFACE ${production_runtime_archives} Shlwapi)
add_library(crucible_imgui STATIC IMPORTED GLOBAL)
add_library(Crucible::ImGui ALIAS crucible_imgui)
set_target_properties(crucible_imgui PROPERTIES
    IMPORTED_LOCATION "${CRUCIBLE_FILAMENT_BUILD_DIR}/third_party/imgui/tnt/imgui.lib")
target_include_directories(crucible_imgui SYSTEM INTERFACE "${CRUCIBLE_FILAMENT_SOURCE_DIR}/third_party/imgui")
message(STATUS "Production import received Filament ${production_source_pin}, ImGui 1.92.5, Windows x64 MSVC Release /MD; UTILS_EXCEPTIONS=0. Native/Apple/Linux/GPU-loss gates remain separate.")
