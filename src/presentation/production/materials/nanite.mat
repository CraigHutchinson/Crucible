material {
    name : CrucibleNanite,
    shadingModel : lit,
    instanced : true,
    requires : [ uv0 ],
    parameters : [
        { type : sampler2d, name : cores },
        { type : int, name : batchBase },
        { type : float, name : glow }
    ]
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        int index = materialParams.batchBase + int(getInstanceIndex());
        float core = texelFetch(materialParams_cores, ivec2(index % 64, index / 64), 0).r;
        // uv0.x carries the generator's NaniteMaterial: 0 silver, 1 graphite, 3 heart.
        int role = int(getUV0().x + 0.5);
        if (role == 3) {
            material.baseColor = vec4(0.03, 0.30, 0.38, 1.0);
            material.metallic = 0.0;
            material.roughness = 0.22;
            material.emissive = vec4(vec3(0.04, 1.1, 1.6) * core * materialParams.glow, 0.0);
        } else if (role == 1) {
            material.baseColor = vec4(0.12, 0.13, 0.15, 1.0);
            material.metallic = 0.7;
            material.roughness = 0.45;
        } else {
            material.baseColor = vec4(0.78, 0.81, 0.85, 1.0);
            material.metallic = 1.0;
            material.roughness = 0.3;
        }
    }
}
