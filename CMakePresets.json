{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CRUCIBLE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "bench",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CRUCIBLE_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "desktop-debug",
      "inherits": "debug",
      "cacheVariables": {
        "CRUCIBLE_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "desktop-release",
      "inherits": "release",
      "cacheVariables": {
        "CRUCIBLE_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "desktop-sanitize",
      "inherits": "sanitize",
      "cacheVariables": {
        "CRUCIBLE_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "desktop-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-homebrew-llvm.cmake"
    },
    {
      "name": "macos-release",
      "inherits": "desktop-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-homebrew-llvm.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release"
    },
    {
      "name": "desktop-sanitize",
      "configurePreset": "desktop-sanitize"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-sanitize",
      "configurePreset": "desktop-sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
